# API key for the embeddings provider. Get an OpenAI key at
# https://platform.openai.com/api-keys. For a free, local model (see below) set
# this to any non-empty placeholder (e.g. "ollama") — local servers ignore it.
# This file is a TEMPLATE. Copy it to .env and fill in the value.
# .env is git-ignored and must NEVER be committed.
OPENAI_API_KEY=

# Optional — defaults are shown below; leave blank to use them.
OPENAI_EMBED_MODEL=text-embedding-3-large
SYNAPSE_DB_PATH=~/.synapse/synapse.db
ENGRAM_DB_PATH=~/.engram/engram.db

# Optional — free & local embeddings.
# Point SYNAPSE_EMBED_ENDPOINT at any OpenAI-compatible server to embed with a
# free local model instead of the OpenAI API. Set SYNAPSE_EMBED_DIMS to that
# model's vector size so stats report it correctly. Example for Ollama:
#   OPENAI_API_KEY=ollama
#   OPENAI_EMBED_MODEL=nomic-embed-text
#   SYNAPSE_EMBED_ENDPOINT=http://localhost:11434/v1/embeddings
#   SYNAPSE_EMBED_DIMS=768
SYNAPSE_EMBED_ENDPOINT=
SYNAPSE_EMBED_DIMS=
